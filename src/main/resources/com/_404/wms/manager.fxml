<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25"
   xmlns:fx="http://javafx.com/fxml/1" fx:controller="com._404.wms.ManagerController">
   <children>
      <BorderPane prefHeight="700.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0"
         AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

         <!-- 顶部标题栏 -->
         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0"
               style="-fx-background-color: #2C3E50;" BorderPane.alignment="CENTER">
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
               <children>
                  <Text fx:id="userNameText" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0"
                     text="欢迎，经理">
                     <font>
                        <Font name="Microsoft YaHei Bold" size="16.0" />
                     </font>
                  </Text>
                  <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="|" />
                  <Text fill="#ECF0F1" strokeType="OUTSIDE" strokeWidth="0.0" text="仓库管理系统 - 经理工作台">
                     <font>
                        <Font name="Microsoft YaHei" size="24.0" />
                     </font>
                  </Text>
                  <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                     <children>
                        <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#logout"
                           prefHeight="40.0" prefWidth="100.0"
                           style="-fx-background-color: #E74C3C; -fx-background-radius: 5;"
                           text="退出登录" textFill="WHITE">
                           <font>
                              <Font name="Microsoft YaHei" size="14.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </top>

         <!-- 左侧菜单 -->
         <left>
            <VBox prefWidth="200.0" spacing="5.0" style="-fx-background-color: #34495E;"
               BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
               <children>
                  <Label text="功能菜单" textFill="WHITE">
                     <font>
                        <Font name="Microsoft YaHei Bold" size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" left="15.0" top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Separator prefWidth="200.0" />

                  <Button fx:id="reportMenuButton" alignment="BASELINE_LEFT" mnemonicParsing="false"
                     onAction="#showReportManagement" prefHeight="45.0" prefWidth="200.0"
                     style="-fx-background-color: #3498DB; -fx-border-width: 0;" text="📊 报表管理"
                     textFill="WHITE">
                     <font>
                        <Font name="Microsoft YaHei" size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </Button>

                  <Button fx:id="approvalMenuButton" alignment="BASELINE_LEFT"
                     mnemonicParsing="false" onAction="#showApprovalCenter" prefHeight="45.0"
                     prefWidth="200.0" style="-fx-background-color: #34495E; -fx-border-width: 0;"
                     text="✓ 审批中心" textFill="WHITE">
                     <font>
                        <Font name="Microsoft YaHei" size="14.0" />
                     </font>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </Button>

                  <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0"
                     prefWidth="200.0" style="-fx-background-color: #34495E; -fx-border-width: 0;"
                     text="📦 库存管理" textFill="WHITE">
                     <font>
                        <Font name="Microsoft YaHei" size="14.0" />
                     </font>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </Button>

                  <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0"
                     prefWidth="200.0" style="-fx-background-color: #34495E; -fx-border-width: 0;"
                     text="👥 员工管理" textFill="WHITE">
                     <font>
                        <Font name="Microsoft YaHei" size="14.0" />
                     </font>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </Button>

                  <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0"
                     prefWidth="200.0" style="-fx-background-color: #34495E; -fx-border-width: 0;"
                     text="⚙️ 系统设置" textFill="WHITE">
                     <font>
                        <Font name="Microsoft YaHei" size="14.0" />
                     </font>
                     <padding>
                        <Insets left="20.0" />
                     </padding>
                  </Button>
               </children>
            </VBox>
         </left>

         <!-- 中间内容区 -->
         <center>
            <StackPane fx:id="contentArea" style="-fx-background-color: #ECF0F1;"
               BorderPane.alignment="CENTER">
               <children>
                  <!-- 报表管理界面 -->
                  <BorderPane fx:id="reportManagementPane" visible="true">
                     <top>
                        <VBox spacing="10.0" style="-fx-background-color: white;"
                           BorderPane.alignment="CENTER">
                           <padding>
                              <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                           </padding>
                           <children>
                              <Label text="报表管理" textFill="#2C3E50">
                                 <font>
                                    <Font name="Microsoft YaHei Bold" size="20.0" />
                                 </font>
                              </Label>

                              <!-- 筛选条件区 -->
                              <HBox alignment="CENTER_LEFT" spacing="15.0">
                                 <children>
                                    <Label text="时间范围：">
                                       <font>
                                          <Font name="Microsoft YaHei" size="13.0" />
                                       </font>
                                    </Label>
                                    <DatePicker fx:id="startDatePicker" prefWidth="150.0"
                                       promptText="开始日期" />
                                    <Label text="至">
                                       <font>
                                          <Font name="Microsoft YaHei" size="13.0" />
                                       </font>
                                    </Label>
                                    <DatePicker fx:id="endDatePicker" prefWidth="150.0"
                                       promptText="结束日期" />

                                    <Label text="商品类别：">
                                       <font>
                                          <Font name="Microsoft YaHei" size="13.0" />
                                       </font>
                                       <HBox.margin>
                                          <Insets left="20.0" />
                                       </HBox.margin>
                                    </Label>
                                    <ComboBox fx:id="categoryComboBox" prefWidth="150.0"
                                       promptText="全部类别" />

                                    <Label text="图表类型：">
                                       <font>
                                          <Font name="Microsoft YaHei" size="13.0" />
                                       </font>
                                       <HBox.margin>
                                          <Insets left="20.0" />
                                       </HBox.margin>
                                    </Label>
                                    <ComboBox fx:id="chartTypeComboBox" onAction="#switchChartType"
                                       prefWidth="120.0" />

                                    <Button mnemonicParsing="false" onAction="#exportReport"
                                       style="-fx-background-color: #27AE60; -fx-background-radius: 5;"
                                       text="导出报表" textFill="WHITE">
                                       <font>
                                          <Font name="Microsoft YaHei" size="13.0" />
                                       </font>
                                       <HBox.margin>
                                          <Insets left="20.0" />
                                       </HBox.margin>
                                    </Button>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </top>

                     <center>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;"
                           BorderPane.alignment="CENTER">
                           <content>
                              <VBox spacing="15.0">
                                 <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                 </padding>
                                 <children>
                                    <!-- 核心数据概览卡片 -->
                                    <HBox spacing="15.0">
                                       <children>
                                          <VBox alignment="CENTER" prefHeight="100.0"
                                             prefWidth="230.0" spacing="5.0"
                                             style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #3498DB; -fx-border-radius: 8; -fx-border-width: 2;"
                                             HBox.hgrow="ALWAYS">
                                             <padding>
                                                <Insets bottom="10.0" left="15.0" right="15.0"
                                                   top="10.0" />
                                             </padding>
                                             <children>
                                                <Label text="本月采购成本" textFill="#7F8C8D">
                                                   <font>
                                                      <Font name="Microsoft YaHei" size="13.0" />
                                                   </font>
                                                </Label>
                                                <Text fx:id="purchaseCostText" fill="#3498DB"
                                                   strokeType="OUTSIDE" strokeWidth="0.0"
                                                   text="¥ 128,500">
                                                   <font>
                                                      <Font name="Microsoft YaHei Bold" size="26.0" />
                                                   </font>
                                                </Text>
                                                <Label text="较上月 +8.5%" textFill="#27AE60">
                                                   <font>
                                                      <Font size="11.0" />
                                                   </font>
                                                </Label>
                                             </children>
                                          </VBox>

                                          <VBox alignment="CENTER" prefHeight="100.0"
                                             prefWidth="230.0" spacing="5.0"
                                             style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #9B59B6; -fx-border-radius: 8; -fx-border-width: 2;"
                                             HBox.hgrow="ALWAYS">
                                             <padding>
                                                <Insets bottom="10.0" left="15.0" right="15.0"
                                                   top="10.0" />
                                             </padding>
                                             <children>
                                                <Label text="当前库存价值" textFill="#7F8C8D">
                                                   <font>
                                                      <Font name="Microsoft YaHei" size="13.0" />
                                                   </font>
                                                </Label>
                                                <Text fx:id="inventoryValueText" fill="#9B59B6"
                                                   strokeType="OUTSIDE" strokeWidth="0.0"
                                                   text="¥ 456,800">
                                                   <font>
                                                      <Font name="Microsoft YaHei Bold" size="26.0" />
                                                   </font>
                                                </Text>
                                                <Label text="库存周转率 2.3" textFill="#7F8C8D">
                                                   <font>
                                                      <Font size="11.0" />
                                                   </font>
                                                </Label>
                                             </children>
                                          </VBox>

                                          <VBox alignment="CENTER" prefHeight="100.0"
                                             prefWidth="230.0" spacing="5.0"
                                             style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E67E22; -fx-border-radius: 8; -fx-border-width: 2;"
                                             HBox.hgrow="ALWAYS">
                                             <padding>
                                                <Insets bottom="10.0" left="15.0" right="15.0"
                                                   top="10.0" />
                                             </padding>
                                             <children>
                                                <Label text="待审批订单" textFill="#7F8C8D">
                                                   <font>
                                                      <Font name="Microsoft YaHei" size="13.0" />
                                                   </font>
                                                </Label>
                                                <Text fx:id="pendingOrdersText" fill="#E67E22"
                                                   strokeType="OUTSIDE" strokeWidth="0.0" text="15">
                                                   <font>
                                                      <Font name="Microsoft YaHei Bold" size="26.0" />
                                                   </font>
                                                </Text>
                                                <Label text="紧急订单 3 个" textFill="#E74C3C">
                                                   <font>
                                                      <Font size="11.0" />
                                                   </font>
                                                </Label>
                                             </children>
                                          </VBox>

                                          <VBox alignment="CENTER" prefHeight="100.0"
                                             prefWidth="230.0" spacing="5.0"
                                             style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #1ABC9C; -fx-border-radius: 8; -fx-border-width: 2;"
                                             HBox.hgrow="ALWAYS">
                                             <padding>
                                                <Insets bottom="10.0" left="15.0" right="15.0"
                                                   top="10.0" />
                                             </padding>
                                             <children>
                                                <Label text="本月出库量" textFill="#7F8C8D">
                                                   <font>
                                                      <Font name="Microsoft YaHei" size="13.0" />
                                                   </font>
                                                </Label>
                                                <Text fx:id="outboundQuantityText" fill="#1ABC9C"
                                                   strokeType="OUTSIDE" strokeWidth="0.0"
                                                   text="2,340">
                                                   <font>
                                                      <Font name="Microsoft YaHei Bold" size="26.0" />
                                                   </font>
                                                </Text>
                                                <Label text="较上月 -2.1%" textFill="#E74C3C">
                                                   <font>
                                                      <Font size="11.0" />
                                                   </font>
                                                </Label>
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>

                                    <!-- 图表区域 -->
                                    <StackPane fx:id="chartContainer" prefHeight="350.0"
                                       style="-fx-background-color: white; -fx-background-radius: 8;">
                                       <padding>
                                          <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                       </padding>
                                       <children>
                                          <!-- 柱状图 -->
                                          <BarChart fx:id="barChart" legendVisible="true"
                                             title="部门采购成本趋势">
                                             <xAxis>
                                                <CategoryAxis label="月份" side="BOTTOM" />
                                             </xAxis>
                                             <yAxis>
                                                <NumberAxis label="金额 (¥)" side="LEFT" />
                                             </yAxis>
                                          </BarChart>

                                          <!-- 折线图 -->
                                          <LineChart fx:id="lineChart" legendVisible="true"
                                             title="库存价值变化趋势" visible="false">
                                             <xAxis>
                                                <CategoryAxis label="日期" side="BOTTOM" />
                                             </xAxis>
                                             <yAxis>
                                                <NumberAxis label="价值 (¥)" side="LEFT" />
                                             </yAxis>
                                          </LineChart>

                                          <!-- 饼图 -->
                                          <PieChart fx:id="pieChart" legendVisible="true"
                                             title="商品类别库存占比" visible="false" />
                                       </children>
                                    </StackPane>

                                    <!-- 数据明细表格 -->
                                    <VBox
                                       style="-fx-background-color: white; -fx-background-radius: 8;">
                                       <padding>
                                          <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                       </padding>
                                       <children>
                                          <Label text="数据明细" textFill="#2C3E50">
                                             <font>
                                                <Font name="Microsoft YaHei Bold" size="16.0" />
                                             </font>
                                             <VBox.margin>
                                                <Insets bottom="10.0" />
                                             </VBox.margin>
                                          </Label>
                                          <TableView fx:id="reportTableView" prefHeight="200.0">
                                             <columns>
                                                <TableColumn fx:id="dateColumn" prefWidth="100.0"
                                                   text="日期" />
                                                <TableColumn fx:id="categoryColumn"
                                                   prefWidth="120.0" text="商品类别" />
                                                <TableColumn fx:id="productNameColumn"
                                                   prefWidth="180.0" text="商品名称" />
                                                <TableColumn fx:id="quantityColumn"
                                                   prefWidth="100.0" text="数量" />
                                                <TableColumn fx:id="unitPriceColumn"
                                                   prefWidth="100.0" text="单价" />
                                                <TableColumn fx:id="totalAmountColumn"
                                                   prefWidth="120.0" text="总金额" />
                                                <TableColumn fx:id="statusColumn" prefWidth="100.0"
                                                   text="状态" />
                                             </columns>
                                          </TableView>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </content>
                        </ScrollPane>
                     </center>
                  </BorderPane>

                  <!-- 审批中心界面 -->
                  <BorderPane fx:id="approvalCenterPane" visible="false">
                     <top>
                        <VBox spacing="10.0" style="-fx-background-color: white;"
                           BorderPane.alignment="CENTER">
                           <padding>
                              <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                           </padding>
                           <children>
                              <Label text="审批中心" textFill="#2C3E50">
                                 <font>
                                    <Font name="Microsoft YaHei Bold" size="20.0" />
                                 </font>
                              </Label>
                              <HBox alignment="CENTER_LEFT" spacing="15.0">
                                 <children>
                                    <Label text="筛选：">
                                       <font>
                                          <Font name="Microsoft YaHei" size="13.0" />
                                       </font>
                                    </Label>
                                    <ComboBox fx:id="approvalStatusComboBox" prefWidth="150.0"
                                       promptText="全部状态" />
                                    <ComboBox fx:id="approvalTypeComboBox" prefWidth="150.0"
                                       promptText="全部类型" />
                                    <Button mnemonicParsing="false"
                                       onAction="#handleRefreshApprovals"
                                       style="-fx-background-color: #3498DB; -fx-background-radius: 5;"
                                       text="刷新" textFill="WHITE">
                                       <font>
                                          <Font name="Microsoft YaHei" size="13.0" />
                                       </font>
                                    </Button>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </top>

                     <center>
                        <VBox spacing="15.0" style="-fx-background-color: #ECF0F1;"
                           BorderPane.alignment="CENTER">
                           <padding>
                              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                           <children>
                              <!-- 待审批任务列表 -->
                              <TableView fx:id="approvalTableView" prefHeight="400.0"
                                 style="-fx-background-color: white; -fx-background-radius: 8;">
                                 <columns>
                                    <TableColumn fx:id="approvalIdColumn" prefWidth="80.0" text="编号" />
                                    <TableColumn fx:id="approvalTypeColumn" prefWidth="100.0"
                                       text="类型" />
                                    <TableColumn fx:id="applicantColumn" prefWidth="100.0"
                                       text="申请人" />
                                    <TableColumn fx:id="approvalTitleColumn" prefWidth="250.0"
                                       text="标题" />
                                    <TableColumn fx:id="approvalAmountColumn" prefWidth="120.0"
                                       text="金额" />
                                    <TableColumn fx:id="applyDateColumn" prefWidth="120.0"
                                       text="申请日期" />
                                    <TableColumn fx:id="priorityColumn" prefWidth="80.0" text="优先级" />
                                    <TableColumn fx:id="approvalStatusColumn" prefWidth="100.0"
                                       text="状态" />
                                 </columns>
                              </TableView>

                              <!-- 审批详情和操作区 -->
                              <HBox spacing="15.0">
                                 <children>
                                    <VBox prefWidth="600.0" spacing="10.0"
                                       style="-fx-background-color: white; -fx-background-radius: 8;"
                                       HBox.hgrow="ALWAYS">
                                       <padding>
                                          <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                       </padding>
                                       <children>
                                          <Label text="审批详情" textFill="#2C3E50">
                                             <font>
                                                <Font name="Microsoft YaHei Bold" size="16.0" />
                                             </font>
                                          </Label>
                                          <Separator prefWidth="200.0" />
                                          <ScrollPane fitToWidth="true" prefHeight="200.0"
                                             style="-fx-background-color: transparent;">
                                             <content>
                                                <VBox fx:id="approvalDetailBox" spacing="8.0">
                                                   <children>
                                                      <Label text="请从上方列表选择待审批任务查看详情"
                                                         textFill="#7F8C8D">
                                                         <font>
                                                            <Font name="Microsoft YaHei" size="13.0" />
                                                         </font>
                                                      </Label>
                                                   </children>
                                                </VBox>
                                             </content>
                                          </ScrollPane>
                                       </children>
                                    </VBox>

                                    <VBox alignment="TOP_CENTER" prefWidth="350.0" spacing="15.0"
                                       style="-fx-background-color: white; -fx-background-radius: 8;">
                                       <padding>
                                          <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                       </padding>
                                       <children>
                                          <Label text="审批操作" textFill="#2C3E50">
                                             <font>
                                                <Font name="Microsoft YaHei Bold" size="16.0" />
                                             </font>
                                          </Label>
                                          <Separator prefWidth="200.0" />

                                          <Button fx:id="approveButton" mnemonicParsing="false"
                                             onAction="#approve" prefHeight="50.0" prefWidth="250.0"
                                             style="-fx-background-color: #27AE60; -fx-background-radius: 8;"
                                             text="✓ 通过审批" textFill="WHITE">
                                             <font>
                                                <Font name="Microsoft YaHei Bold" size="16.0" />
                                             </font>
                                          </Button>

                                          <Button fx:id="rejectButton" mnemonicParsing="false"
                                             onAction="#reject" prefHeight="50.0" prefWidth="250.0"
                                             style="-fx-background-color: #E74C3C; -fx-background-radius: 8;"
                                             text="✗ 退回修改" textFill="WHITE">
                                             <font>
                                                <Font name="Microsoft YaHei Bold" size="16.0" />
                                             </font>
                                          </Button>

                                          <Button mnemonicParsing="false" prefHeight="40.0"
                                             prefWidth="250.0"
                                             style="-fx-background-color: #95A5A6; -fx-background-radius: 8;"
                                             text="转发审批" textFill="WHITE">
                                             <font>
                                                <Font name="Microsoft YaHei" size="14.0" />
                                             </font>
                                          </Button>

                                          <VBox alignment="CENTER" spacing="5.0"
                                             style="-fx-background-color: #ECF0F1; -fx-background-radius: 5;">
                                             <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0"
                                                   top="10.0" />
                                             </padding>
                                             <children>
                                                <Label text="待处理" textFill="#7F8C8D">
                                                   <font>
                                                      <Font name="Microsoft YaHei" size="12.0" />
                                                   </font>
                                                </Label>
                                                <Text fx:id="pendingCountText" fill="#E67E22"
                                                   strokeType="OUTSIDE" strokeWidth="0.0" text="15">
                                                   <font>
                                                      <Font name="Microsoft YaHei Bold" size="32.0" />
                                                   </font>
                                                </Text>
                                                <Label text="个审批任务" textFill="#7F8C8D">
                                                   <font>
                                                      <Font size="11.0" />
                                                   </font>
                                                </Label>
                                             </children>
                                          </VBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </center>
                  </BorderPane>
               </children>
            </StackPane>
         </center>
      </BorderPane>
   </children>
</AnchorPane>