<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="800.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com._404.wms.WarehouseAdminController">
    <!-- 顶部栏 -->
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50; -fx-padding: 15px;">
            <Text fill="WHITE" text="仓库管理系统 - 仓库管理员工作台">
                <font>
                    <Font name="Microsoft YaHei Bold" size="24.0" />
                </font>
            </Text>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="userInfoLabel" text="当前用户: " textFill="WHITE">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
            <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                text="退出登录">
                <HBox.margin>
                    <Insets left="20.0" />
                </HBox.margin>
            </Button>
        </HBox>
    </top>

    <!-- 左侧菜单 -->
    <left>
        <VBox style="-fx-background-color: #34495e; -fx-padding: 10px;"
            BorderPane.alignment="CENTER">
            <Button fx:id="productMenuButton" mnemonicParsing="false"
                onAction="#showProductManagement" prefWidth="180.0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 15px;"
                text="产品管理">
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Button>
            <Button fx:id="stockMenuButton" mnemonicParsing="false" onAction="#showStockManagement"
                prefWidth="180.0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 15px;"
                text="库存管理">
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Button>
            <Button fx:id="userMenuButton" mnemonicParsing="false" onAction="#showUserManagement"
                prefWidth="180.0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 15px;"
                text="用户管理">
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Button>
            <Button fx:id="reportMenuButton" mnemonicParsing="false"
                onAction="#showReportManagement" prefWidth="180.0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 15px;"
                text="报表统计">
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- 中心内容区 -->
    <center>
        <StackPane fx:id="contentPane" BorderPane.alignment="CENTER">
            <!-- 产品管理面板 -->
            <VBox fx:id="productPane" spacing="20.0" style="-fx-padding: 30px;" visible="true">
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <Text text="产品管理">
                        <font>
                            <Font name="Microsoft YaHei Bold" size="28.0" />
                        </font>
                    </Text>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleAddProduct"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 20px;"
                        text="+ 添加产品" />
                </HBox>

                <!-- 搜索栏 -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <TextField fx:id="productSearchField" promptText="搜索产品名称或编号..."
                        prefWidth="300.0" />
                    <Button onAction="#handleSearchProduct"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;" text="搜索" />
                    <Button onAction="#handleRefreshProducts"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="刷新" />
                </HBox>

                <!-- 产品列表 -->
                <TableView fx:id="productTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="productIdColumn" prefWidth="100.0" text="产品编号" />
                        <TableColumn fx:id="productNameColumn" prefWidth="150.0" text="产品名称" />
                        <TableColumn fx:id="categoryColumn" prefWidth="100.0" text="类别" />
                        <TableColumn fx:id="priceColumn" prefWidth="100.0" text="单价" />
                        <TableColumn fx:id="currentStockColumn" prefWidth="100.0" text="当前库存" />
                        <TableColumn fx:id="unitColumn" prefWidth="80.0" text="单位" />
                        <TableColumn fx:id="minStockColumn" prefWidth="100.0" text="最低库存" />
                        <TableColumn fx:id="maxStockColumn" prefWidth="100.0" text="最高库存" />
                        <TableColumn fx:id="supplierColumn" prefWidth="120.0" text="供应商" />
                        <TableColumn fx:id="productActionColumn" prefWidth="150.0" text="操作" />
                    </columns>
                </TableView>
            </VBox>

            <!-- 库存管理面板 -->
            <VBox fx:id="stockPane" spacing="20.0" style="-fx-padding: 30px;" visible="false">
                <Text text="库存管理">
                    <font>
                        <Font name="Microsoft YaHei Bold" size="28.0" />
                    </font>
                </Text>

                <!-- 入库/出库选项卡 -->
                <TabPane tabClosingPolicy="UNAVAILABLE">
                    <Tab text="入库登记">
                        <VBox spacing="15.0" style="-fx-padding: 20px;">
                            <GridPane hgap="15.0" vgap="15.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
                                </columnConstraints>
                                <Label text="产品:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <ComboBox fx:id="stockInProductCombo" prefWidth="200.0"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="入库数量:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                <TextField fx:id="stockInQuantityField" promptText="请输入数量"
                                    GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                <Label text="批次号:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="batchNumberField" promptText="系统自动生成"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="仓库位置:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="warehouseLocationField" promptText="例如: A区-01货架"
                                    GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                <Label text="备注:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextArea fx:id="stockInRemarkArea" prefHeight="80.0"
                                    promptText="入库备注信息" wrapText="true" GridPane.columnIndex="1"
                                    GridPane.columnSpan="3" GridPane.rowIndex="2" />
                            </GridPane>

                            <HBox alignment="CENTER" spacing="20.0">
                                <Button onAction="#handleStockIn"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px 30px;"
                                    text="确认入库" />
                                <Button onAction="#handleClearStockInForm"
                                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px 30px;"
                                    text="清空表单" />
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="出库登记">
                        <VBox spacing="15.0" style="-fx-padding: 20px;">
                            <GridPane hgap="15.0" vgap="15.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
                                </columnConstraints>
                                <Label text="产品:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <ComboBox fx:id="stockOutProductCombo" prefWidth="200.0"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="出库数量:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                <TextField fx:id="stockOutQuantityField" promptText="请输入数量"
                                    GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                <Label text="领用人:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="recipientField" promptText="请输入领用人"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="领用部门:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="recipientDeptField" promptText="请输入部门"
                                    GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                <Label text="备注:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextArea fx:id="stockOutRemarkArea" prefHeight="80.0"
                                    promptText="出库备注信息" wrapText="true" GridPane.columnIndex="1"
                                    GridPane.columnSpan="3" GridPane.rowIndex="2" />
                            </GridPane>

                            <HBox alignment="CENTER" spacing="20.0">
                                <Button onAction="#handleStockOut"
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px 30px;"
                                    text="确认出库" />
                                <Button onAction="#handleClearStockOutForm"
                                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10px 30px;"
                                    text="清空表单" />
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="库存记录">
                        <VBox spacing="10.0" style="-fx-padding: 20px;">
                            <HBox spacing="10.0">
                                <Button onAction="#handleRefreshStockRecords"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white;"
                                    text="刷新记录" />
                                <Button onAction="#handleFetchApprovedOrders"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"
                                    text="获取已批准订单" />
                                <ComboBox fx:id="recordTypeCombo" promptText="记录类型" />
                            </HBox>
                            <TableView fx:id="stockRecordTableView" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="recordIdColumn" prefWidth="120.0"
                                        text="记录编号" />
                                    <TableColumn fx:id="recordTypeColumn" prefWidth="80.0" text="类型" />
                                    <TableColumn fx:id="recordProductColumn" prefWidth="120.0"
                                        text="产品" />
                                    <TableColumn fx:id="recordQuantityColumn" prefWidth="80.0"
                                        text="数量" />
                                    <TableColumn fx:id="recordOperatorColumn" prefWidth="100.0"
                                        text="操作员" />
                                    <TableColumn fx:id="recordTimeColumn" prefWidth="150.0"
                                        text="操作时间" />
                                    <TableColumn fx:id="recordRemarkColumn" prefWidth="200.0"
                                        text="备注" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>

            <!-- 用户管理面板 -->
            <VBox fx:id="userPane" spacing="20.0" style="-fx-padding: 30px;" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <Text text="用户管理">
                        <font>
                            <Font name="Microsoft YaHei Bold" size="28.0" />
                        </font>
                    </Text>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleAddUser"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 20px;"
                        text="+ 添加用户" />
                </HBox>

                <!-- 用户列表 -->
                <TableView fx:id="userTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="userIdColumn" prefWidth="120.0" text="用户ID" />
                        <TableColumn fx:id="usernameColumn" prefWidth="150.0" text="用户名" />
                        <TableColumn fx:id="fullNameColumn" prefWidth="150.0" text="姓名" />
                        <TableColumn fx:id="roleColumn" prefWidth="150.0" text="角色" />
                        <TableColumn fx:id="createTimeColumn" prefWidth="180.0" text="创建时间" />
                        <TableColumn fx:id="lastLoginColumn" prefWidth="180.0" text="最后登录" />
                        <TableColumn fx:id="userActionColumn" prefWidth="150.0" text="操作" />
                    </columns>
                </TableView>
            </VBox>

            <!-- 报表统计面板 -->
            <VBox fx:id="reportPane" spacing="20.0" style="-fx-padding: 30px;" visible="false">
                <Text text="报表统计">
                    <font>
                        <Font name="Microsoft YaHei Bold" size="28.0" />
                    </font>
                </Text>

                <GridPane hgap="20.0" vgap="20.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" />
                    </columnConstraints>

                    <!-- 统计卡片 -->
                    <VBox
                        style="-fx-background-color: #3498db; -fx-background-radius: 10; -fx-padding: 20px;"
                        GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Text fill="WHITE" text="产品总数">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Text>
                        <Text fx:id="totalProductsText" fill="WHITE" text="0">
                            <font>
                                <Font name="Microsoft YaHei Bold" size="36.0" />
                            </font>
                        </Text>
                    </VBox>

                    <VBox
                        style="-fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-padding: 20px;"
                        GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Text fill="WHITE" text="库存预警">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Text>
                        <Text fx:id="lowStockText" fill="WHITE" text="0">
                            <font>
                                <Font name="Microsoft YaHei Bold" size="36.0" />
                            </font>
                        </Text>
                    </VBox>

                    <VBox
                        style="-fx-background-color: #27ae60; -fx-background-radius: 10; -fx-padding: 20px;"
                        GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Text fill="WHITE" text="用户总数">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Text>
                        <Text fx:id="totalUsersText" fill="WHITE" text="0">
                            <font>
                                <Font name="Microsoft YaHei Bold" size="36.0" />
                            </font>
                        </Text>
                    </VBox>
                </GridPane>

                <HBox spacing="20.0" style="-fx-padding-top: 30px;">
                    <Button onAction="#handleExportReport"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 20px;"
                        text="导出报表" />
                    <Button onAction="#handleViewLogs"
                        style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 20px;"
                        text="查看日志" />
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>